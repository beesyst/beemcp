[Unit]
Description=BeeMCP server
After=network.target

[Service]
Type=simple
WorkingDirectory=@@SCRIPT_DIR@@
ExecStart="@@VENV_PYTHON@@" "@@SCRIPT_DIR@@/server.py"
Environment="BEEMCP_HOST=@@MCP_HOST@@"
Environment="BEEMCP_PORT=@@MCP_PORT@@"
EnvironmentFile=@@MCP_ENV_FILE@@
Restart=on-failure
RestartSec=3